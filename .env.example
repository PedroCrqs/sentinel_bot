# Canonical runtime configuration
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/sentinel_db
RABBITMQ_URL=amqp://localhost:5672

# Neo4j is not provisioned in the current local Docker environment.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=CHANGE_ME

# Optional collector filter. Comma-separated WhatsApp IDs.
BLOCKED_IDS=

# Required by wpp-egress; do not commit real IDs here.
GROUP_ID=
PRIORITY_CONTACT_ID=
